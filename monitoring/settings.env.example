MONITORING_LISTEN_ADDR=:8090
MONITORING_INTERVAL=60s
MONITORING_REQUEST_TIMEOUT=30s
MONITORING_RETENTION=720h
MONITORING_PROBE_CONCURRENCY=8
MONITORING_FAILURE_THRESHOLD=2
MONITORING_RECOVERY_THRESHOLD=1
MONITORING_DEFAULT_MODEL=gpt-4o-mini
MONITORING_ALLOW_PRIVATE_HOSTS=false
MONITORING_FRAME_ANCESTORS='self'
MONITORING_CONCURRENCY_SLOT_TTL=30m
# Cost anomaly analysis. Set the QQ password to an SMTP authorization code.
MONITORING_COST_ALERTS_ENABLED=true
MONITORING_COST_WINDOW=15m
MONITORING_COST_BASELINE=168h
MONITORING_COST_COOLDOWN=30m
MONITORING_COST_MIN_REQUESTS=3
MONITORING_COST_MIN_TOKENS=100000
MONITORING_COST_CACHE_MISS_MIN_REQUESTS=3
MONITORING_COST_CACHE_MISS_INPUT_TOKENS=100000
MONITORING_COST_CACHE_MISS_MIN_COST=0.5
MONITORING_COST_CACHE_MISS_MAX_SPAN=5m
MONITORING_COST_ACCOUNT_SWITCH_MIN_TRANSITIONS=2
MONITORING_COST_MIN_COST=0.5
MONITORING_COST_SINGLE_REQUEST_COST=5
MONITORING_COST_MIN_BASE_COST=0.1
MONITORING_COST_CACHE_BASELINE_MIN=0.60
MONITORING_COST_CACHE_CURRENT_MAX=0.20
MONITORING_COST_CACHE_COST_RATIO=1.5
MONITORING_COST_UNIT_COST_RATIO=1.5
MONITORING_COST_MULTIPLIER_RATIO=2.0
# 0 disables the per-user budget-burn rule.
MONITORING_COST_DAILY_BUDGET=0
MONITORING_COST_BURN_RATIO=1.5
MONITORING_COST_EMAIL_HOST=smtp.qq.com
MONITORING_COST_EMAIL_PORT=465
MONITORING_COST_EMAIL_SECURITY=implicit_tls
MONITORING_COST_EMAIL_USERNAME=
MONITORING_COST_EMAIL_PASSWORD=
MONITORING_COST_EMAIL_FROM=
MONITORING_COST_EMAIL_TO=
MONITORING_COST_EMAIL_TIMEOUT=15s
TZ=Asia/Shanghai
