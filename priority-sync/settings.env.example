PRIORITY_SYNC_INTERVAL=10m
PRIORITY_SYNC_WINDOW=24h
PRIORITY_SYNC_CHANGE_COOLDOWN=15m
PRIORITY_SYNC_MIN_SAMPLES=5
PRIORITY_SYNC_CONFIRMATIONS=2
# JSON rule list: rules are OR-ed, fields in one rule are AND-ed. A group list
# matches any listed group. Matching accounts are excluded from automatic
# priority scoring, exploration, recovery, and Admin API writes.
PRIORITY_SYNC_EXCLUDE_RULES=[{"platform":"openai","type":"oauth"}]
# To limit the exclusion to several business groups, replace the value above:
# PRIORITY_SYNC_EXCLUDE_RULES=[{"platform":"openai","type":"oauth","groups":["西郊-gpt"]},{"platform":"openai","type":"oauth","groups":["策略-gpt-低价","策略-gpt-高阶"]}]
# Optional ordinary cold-account exploration. Multiplier-anchor recovery trials remain independently active.
PRIORITY_SYNC_EXPLORATION_ENABLED=false
# Set true only when recommendations should be reported without Admin API updates.
PRIORITY_SYNC_DRY_RUN=false
